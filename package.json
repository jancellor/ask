{
  "name": "@jancellor/ask",
  "version": "1.0.0",
  "description": "A minimal coding agent CLI.",
  "main": "dist/index.js",
  "bin": {
    "ask": "./dist/index.js"
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "tsx src/index.ts",
    "prepublishOnly": "npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [
    "ai",
    "agent",
    "coding-agent",
    "assistant",
    "cli",
    "terminal",
    "llm"
  ],
  "author": "jancellor",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jancellor/ask.git"
  },
  "bugs": {
    "url": "https://github.com/jancellor/ask/issues"
  },
  "homepage": "https://github.com/jancellor/ask#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.48",
    "@ai-sdk/google": "^3.0.33",
    "@ai-sdk/openai": "^3.0.36",
    "@ai-sdk/openai-compatible": "^2.0.30",
    "ai": "^6.0.90",
    "ai-sdk-provider-codex-cli": "^1.1.0",
    "commander": "^14.0.3",
    "ink": "^6.7.0",
    "lodash-es": "^4.17.23",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "react": "^19.2.4",
    "yaml": "^2.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/lodash-es": "^4.17.12",
    "@types/marked-terminal": "^6.1.1",
    "@types/node": "^25.2.3",
    "@types/react": "^19.2.14",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
